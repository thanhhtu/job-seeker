DATABASE_URL=
DATABASE_DB=
DATABASE_PASSWORD=
DATABASE_USER=

MISTRAL_API_KEY=your_mistral_api_key
OLLAMA_BASE_URL=http://localhost:11434     # Ollama embedding service
RERANKER_URL=http://localhost:8001         # BGE Reranker service

LANGSMITH_API_KEY=                         # Optional
LANGSMITH_TRACING=false
